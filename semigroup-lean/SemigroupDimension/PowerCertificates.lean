theorem nonintegral_pow_9 : ¬ IntegralMatrix (witness ^ 9) := by
  intro h
  have hd := (integralMatrix_iff_den _).mp h 1 0
  rw [power_certificate 9 (by omega)] at hd
  have bad : ((certificate 9) 1 0).den ≠ 1 := by norm_num [certificate]
  exact bad hd

