theorem certificate_zero : certificate 0 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [certificate]

theorem certificate_step (n : Fin 18) :
    certificate (n.val + 1) = certificate n.val * witness := by
  fin_cases n <;> ext i j <;> fin_cases i <;> fin_cases j <;>
    norm_num [certificate, witness, Matrix.mul_apply, Fin.sum_univ_succ]

theorem power_certificate (n : ℕ) (hn : n ≤ 18) :
    witness ^ n = certificate n := by
  induction n with
  | zero => simpa using certificate_zero.symm
  | succ n ih =>
    have hlt : n < 18 := by omega
    rw [pow_succ, ih (by omega)]
    exact (certificate_step ⟨n, hlt⟩).symm

theorem integral_pow_5 : IntegralMatrix (witness ^ 5) := by
  rw [integralMatrix_iff_den, power_certificate 5 (by omega)]
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [certificate]

